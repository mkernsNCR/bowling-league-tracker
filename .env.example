# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=your-session-secret-here

# Rate Limiting
RATE_LIMIT_OCR=10

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/bowling_league

# Google OAuth
GOOGLE_CLIENT_ID=
